# systemd unit for SolarWatch.
#   sudo cp deploy/solarwatch.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now solarwatch
#   journalctl -u solarwatch -f
#
# Edit WorkingDirectory / User / ExecStart if you did not follow deploy/DEPLOY.md
# exactly (it assumes /opt/solarwatch, user "solarwatch", and node on PATH).

[Unit]
Description=SolarWatch — DessMonitor to WhatsApp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=solarwatch
WorkingDirectory=/opt/solarwatch
ExecStart=/usr/bin/env node src/index.js
EnvironmentFile=/opt/solarwatch/.env
Restart=always
RestartSec=10
# Give the WhatsApp socket time to close cleanly on stop.
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
# Light hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
