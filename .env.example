# Copy to .env and fill in. On a managed host you can instead set these as the
# platform's environment variables and skip the file entirely.

# ================================================================
#  Notifier
# ================================================================
# whatsapp | webhook
NOTIFY_DRIVER=whatsapp

# --- WhatsApp (NOTIFY_DRIVER=whatsapp) ---
# Run `npm run list-groups` (scan the QR once), then `npm run join-group` if the
# linked number isn't in the target group yet.
WHATSAPP_GROUP_ID=
WHATSAPP_GROUP_NAME=

# --- Webhook (NOTIFY_DRIVER=webhook) ---
# WEBHOOK_FORMAT: json (body {"text": ...}) | slack ({"text": ...}) |
#                discord ({"content": ...}) | ntfy (raw text body)
WEBHOOK_URL=
WEBHOOK_FORMAT=json

# ================================================================
#  DessMonitor account
# ================================================================
DESS_USERNAME=your_dessmonitor_username
DESS_PASSWORD=your_dessmonitor_password
# Public vendor key the dessmonitor.com web app itself uses — not a secret.
DESS_COMPANY_KEY=bnrl_frRFjEz8Mkn

# ---- Target device ----  (run `npm run list-devices`)
DESS_PN=
DESS_SN=
DESS_DEVCODE=
DESS_DEVADDR=
# Nominal DC bank voltage (12 / 24 / 48). The inverter usually reports it; this is the
# fallback, and it sets the default battery alert thresholds (see below).
DESS_BATTERY_VOLTAGE=48

# ================================================================
#  Schedule
# ================================================================
STATUS_CRON=0 * * * *          # hourly "what's happening" heartbeat
ALERT_CRON=*/10 * * * *        # problem check
TZ=UTC                         # e.g. Europe/London, America/New_York, Asia/Karachi
QUIET_HOURS=                   # e.g. 22-6 to mute heartbeat + non-critical alerts overnight
ALERTS_IN_QUIET_HOURS=critical # critical | all | none
DAILY_REPORT_HOUR=21          # nightly summary hour (0 disables)

# ================================================================
#  Alert thresholds
# ================================================================
UTILITY_NAME=Grid              # what to call mains power in messages (e.g. WAPDA, Eskom, PG&E)
DAYLIGHT_START=7               # hours solar is expected (used by the "no solar" alert)
DAYLIGHT_END=20
SOLAR_END_AFTER_HOUR=16        # after this hour, 0 solar = normal end of day (not an alarm)
OVERLOAD_PCT=90               # alert when load reaches this % of the inverter's rated power
SOLAR_MIN_W=40                # below this = "no solar"
SOLAR_ON_W=100               # above this = "solar producing"
HEAVY_LOAD_W=1000            # shown as context in the reduce-load alert
STALE_DATA_MIN=20            # data older than this ⇒ treat the inverter as offline
SOLAR_DAILY_SUMMARY=true      # the once-a-day "solar started / stopped" notes

# Battery alert voltages. Leave BLANK to auto-derive from DESS_BATTERY_VOLTAGE
# (lead-acid curve). Override for your chemistry — e.g. LiFePO4 on a 24 V bank:
#   BATTERY_LOW_V=25.6  BATTERY_CRITICAL_V=24.8
BATTERY_LOW_V=
BATTERY_CRITICAL_V=

# Grid-voltage safety band (while the grid is present). Leave BLANK to auto-derive
# from the inverter's nominal AC voltage (works for 120 V and 230 V mains).
GRID_MIN_V=                    # below this ⇒ grid considered OFF
GRID_BACK_V=
GRID_V_LOW=                    # below this while present ⇒ abnormal-low alert
GRID_V_HIGH=                   # above this ⇒ abnormal-high alert

# ================================================================
#  Battery bank — enables the "battery will last ~Xh" estimate
# ================================================================
BATTERY_CAPACITY_AH=           # total Ah of the bank (leave empty to disable estimates)
BATTERY_AGE_FACTOR=0.8        # derate for battery age (new ≈ 1.0)
BATTERY_STOP_V=               # blank ⇒ derived from DESS_BATTERY_VOLTAGE
BATTERY_FULL_REST_V=

# ================================================================
#  Solar array — enables the "panels underperforming" alert
# ================================================================
PV_ARRAY_W=                    # sum of panel wattages (leave empty to disable)
PV_UNDERPERFORM_PCT=35
PV_PEAK_START=11
PV_PEAK_END=15

# ================================================================
#  Misc
# ================================================================
NOTIFY_ON_ERROR=false
# Directory for .baileys_auth/ and .state.json (empty = project folder).
SOLARWATCH_DATA_DIR=
